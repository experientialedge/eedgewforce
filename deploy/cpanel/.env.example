# Copy to .env inside the PRIVATE application root, outside public_html.
NODE_ENV=production
CLIENT_URL=https://workforce.yourdomain.com
PORT=3000
# Confirm the proxy path with the host. One trusted reverse proxy is usual.
TRUST_PROXY_HOPS=1
# cPanel cron runs reminders; Passenger may sleep or start multiple processes.
REMINDER_WORKER_ENABLED=false
JWT_SECRET=
SUPABASE_URL=https://kfvtgqigidgazmbfsfuc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SCHEMA_LAYOUT=
SUPABASE_STORAGE_BUCKET=edgewforce-media
# Preserve the current production values when migrating; do not disable enforcement.
WORKFORCE_GEOFENCE_ENFORCED=true
WORKFORCE_REPORTS_ENABLED=true
HR_DAILY_REPORTS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=experientialedge57@gmail.com
SMTP_PASS=
EMAIL_FROM=experientialedge57@gmail.com
CRON_SECRET=
# Existing factual analytics work; private model explanations require a model server.
NEXUS_ENABLED=true
NEXUS_MODEL_PROVIDER=ollama
NEXUS_MODEL_URL=
NEXUS_MODEL=
NEXUS_MODEL_API_KEY=
