# ==============================================================================
# EDGEWFORCE - PRODUCTION ENVIRONMENT TEMPLATE (Vercel or a Node server)
# ==============================================================================

NODE_ENV=production
PORT=3000
CLIENT_URL=https://yourdomain.com
# Generate a private random secret of at least 32 characters. Never commit the real value.
JWT_SECRET=

# Optional: Supabase Production PostgreSQL & Cloud Storage
# When set, EdgeWForce automatically connects to Supabase Cloud PostgreSQL.
# When left blank, EdgeWForce runs high-fidelity standalone persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack API Keys (Nigerian Commercial Payments)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxx

# AI Engine Provider (internal, openai, gemini, or anthropic)
AI_PROVIDER=internal
AI_API_KEY=

# Email / Notifications (Gmail SMTP; app password requires Google 2-Step Verification)
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=
EMAIL_FROM=your-address@gmail.com

# Optional alternative map provider (public browser configuration, never SMTP secrets).
# Leave blank to use OpenStreetMap tiles. Custom HTTPS URLs require {z}/{x}/{y} and attribution.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Monthly Sales Target Default (NGN)
MONTHLY_SALES_TARGET=25000000

# Enable only after additive migration 013 and real market assignments are verified.
WORKFORCE_GEOFENCE_ENFORCED=false
WORKFORCE_REPORTS_ENABLED=false
EXECUTIVE_AI_PROVIDER=openai
OPENAI_API_KEY=
AI_EXECUTIVE_MODEL=

# Self-hosted NEXUS; requires migration 014. No OpenAI account needed.
NEXUS_ENABLED=false
NEXUS_MODEL_PROVIDER=ollama
NEXUS_MODEL_URL=
NEXUS_MODEL=
NEXUS_MODEL_API_KEY=

# Daily Excel reports: install migration 015. Keep CRON_SECRET private.
HR_DAILY_REPORTS_ENABLED=false
CRON_SECRET=
