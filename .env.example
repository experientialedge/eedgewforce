# ==============================================================================
# EDGEWFORCE - PRODUCTION ENVIRONMENT CONFIGURATION (Vercel + Supabase)
# ==============================================================================

NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-custom-domain.com

# JWT Secret for Session & API Token Signing
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters

# Supabase PostgreSQL & Cloud Services
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Supabase Storage Bucket for Uploads (Default: edgewforce-media)
SUPABASE_STORAGE_BUCKET=edgewforce-media

# Paystack API Keys (Nigerian Commercial Payments)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxx

# AI Engine Provider (internal, openai, gemini, or anthropic)
AI_PROVIDER=internal
AI_API_KEY=

# Email / Notifications (Resend / SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxx
EMAIL_FROM=operations@your-custom-domain.com

# Commercial Sales Defaults (NGN)
MONTHLY_SALES_TARGET=25000000

# Enable only after additive migration 013 and real market assignments are verified.
WORKFORCE_GEOFENCE_ENFORCED=false
WORKFORCE_REPORTS_ENABLED=false
EXECUTIVE_AI_PROVIDER=openai
OPENAI_API_KEY=
AI_EXECUTIVE_MODEL=

# Self-hosted NEXUS; requires migration 014. No OpenAI account needed.
NEXUS_ENABLED=false
NEXUS_MODEL_PROVIDER=ollama
NEXUS_MODEL_URL=
NEXUS_MODEL=
NEXUS_MODEL_API_KEY=
